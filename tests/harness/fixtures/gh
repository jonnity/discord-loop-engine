#!/usr/bin/env bash
# テスト用の gh スタブ。harness-inbox が呼ぶ問い合わせにだけ fixture を返す。
D="$(cd "$(dirname "$0")" && pwd)"
if [ "${PHASE_STUB:-0}" = 1 ]; then
 exec node "${PHASE_GH_FIXTURE:-$D/phase-gh.ts}" "$@"
fi
if [ "${RUNNER_STUB:-0}" = 1 ]; then
	[ "$*" = "api --paginate repos/example/project/actions/runners" ] || exit 1
	[ "${RUNNER_FAIL:-0}" = 1 ] && exit 1
	cat "$RUNNER_PAGES"
	exit
fi
# REST の全ページ形式は pr fixture から返す。
case "$*" in
"repo view --json nameWithOwner -q .nameWithOwner") echo jonnity/r; exit ;;
"api user --jq .login") echo bot; exit ;;
"issue view 5 --json labels"|"issue view 6 --json labels") echo '{"labels":[{"name":"harness:awaiting-merge"}]}'; exit ;;
"issue view 7 --json labels") echo '{"labels":[{"name":"harness:awaiting-merge"},{"name":"harness:merge-ok"}]}'; exit ;;
esac
for pr in 15 16 17; do
 case "$*" in
 "pr view $pr --json headRefOid,url") jq '{headRefOid,url}' "$D/pr$pr.json"; exit ;;
 "api --paginate --slurp repos/jonnity/r/issues/$pr/comments") jq '[.comments]' "$D/pr$pr.json"; exit ;;
 "api --paginate --slurp repos/jonnity/r/pulls/$pr/reviews") jq '[.reviews // []]' "$D/pr$pr.json"; exit ;;
 esac
done
case "$*" in
"repo view --json owner -q .owner.login") echo jonnity ;;
*"issue list --state open --label harness:interview"*) echo 3 ;;
*"issue list --state open --label harness:awaiting-merge"*) printf '5\n6\n7\n' ;;
"issue view 3 --json comments") cat "$D/issue3.json" ;;
"issue view 5 --json labels -q .labels[].name") echo harness:awaiting-merge ;;
"issue view 6 --json labels -q .labels[].name") echo harness:awaiting-merge ;;
"issue view 7 --json labels -q .labels[].name") printf 'harness:awaiting-merge\nharness:merge-ok\n' ;;
*"pr list --state open --head fix/issue-5"*) echo 15 ;;
*"pr list --state open --head fix/issue-6"*) echo 16 ;;
*"pr list --state open --head fix/issue-7"*) echo 17 ;;
"pr view 15 --json comments,reviews,headRefOid,url") cat "$D/pr15.json" ;;
"pr view 16 --json comments,reviews,headRefOid,url") cat "$D/pr16.json" ;;
"pr view 17 --json comments,reviews,headRefOid,url") cat "$D/pr17.json" ;;
"issue view 20 --json number,title,body,comments") cat "$D/issue20.json" ;;
"issue view 21 --json number,title,body,comments") cat "$D/issue21.json" ;;
"issue view 22 --json number,title,body,comments") cat "$D/issue22.json" ;;
*) echo "gh stub: unexpected: $*" >&2; exit 1 ;;
esac
