{
	"name": "discord-loop-engine",
	"version": "0.1.0",
	"private": true,
	"description": "Discord を窓口に、ローカルの Claude Code が Issue 駆動で開発ループを回し続けるエンジン",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"bin": {
		"dle": "bin/dle"
	},
	"scripts": {
		"test": "node --test test/*.test.ts && bash tests/harness/run.sh",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"check:ci": "biome ci ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@types/node": "24.5.2",
		"typescript": "5.9.2"
	}
}
