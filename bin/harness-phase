#!/usr/bin/env bash
#
# harness-phase — Issue のフェーズ（harness:* ラベル）を遷移させる唯一の入口。
#
# awaiting-merge は追跡ラベル→pending→必須通知→照合→完成PATCH→ラベル確認。
# ラベルだけでは依頼完了を表さない。その他の人間ゲートはコメント→通知→ラベル。
# 詳細は README の承認動画の手順を参照。
#
# 使い方:
#   harness-phase <issue> <phase> [--comment-file F | --comment TEXT] [--pr N] [--file F]
#                 [--summary TEXT] [--notify]
#
# phase:
#   queued | interview | designing | spec-review | implementing | impl-review | awaiting-merge | blocked | done
#
#   interview      : --comment(-file) 必須。Issue にコメントし Discord へ「要件確認」
#   awaiting-merge : --pr と --comment(-file) 必須。PR にコメント（head sha を埋め込む）し「マージ承認依頼」
#   blocked        : --comment(-file) 必須。Issue にコメントし「要対応」
#   done           : harness:* ラベルを全部外す（「マージ完了」の通知は、done の報告を受けた engine が出す）
#   その他         : ラベルの付け替えのみ。--notify を付けると「着手/お知らせ」を通知
#
# --summary は Discord embed に出す短い要約（省略時はコメント冒頭 300 文字）。

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PHASES=(queued interview designing spec-review implementing impl-review awaiting-merge blocked)

ISSUE="${1:-}"
PHASE="${2:-}"
if [ -z "$ISSUE" ] || [ -z "$PHASE" ]; then
	sed -n '2,30p' "$0" >&2
	exit 2
fi
shift 2

COMMENT="" COMMENT_FILE="" PR="" FILE="" SUMMARY="" NOTIFY=0
while [ $# -gt 0 ]; do
	case "$1" in --comment|--comment-file|--pr|--file|--summary) [ $# -ge 2 ] || exit 2 ;; esac
	case "$1" in
	--comment) COMMENT="$2"; shift 2 ;;
	--comment-file) COMMENT_FILE="$2"; shift 2 ;;
	--pr) PR="$2"; shift 2 ;;
	--file) FILE="$2"; shift 2 ;;
	--summary) SUMMARY="$2"; shift 2 ;;
	--notify) NOTIFY=1; shift ;;
	*)
		echo "harness-phase: 不明な引数 $1" >&2
		exit 2
		;;
	esac
done

valid=0
for p in "${PHASES[@]}" "done"; do [ "$p" = "$PHASE" ] && valid=1; done
if [ "$valid" = 0 ]; then
	echo "harness-phase: 不明なフェーズ $PHASE" >&2
	exit 2
fi

# 添付は engine の cwd から見えないので、絶対パスにしてから渡す。無ければ通知を出さず失敗する
if [ -n "$FILE" ] && [ "$PHASE" != awaiting-merge ]; then
	file_dir=""
	[ -f "$FILE" ] && file_dir="$(cd -- "$(dirname -- "$FILE")" 2>/dev/null && pwd)"
	if [ -z "$file_dir" ]; then
		echo "harness-phase: 添付ファイルが見つかりません（$FILE）。通知は出していません" >&2
		exit 4
	fi
	FILE="${file_dir%/}/$(basename -- "$FILE")"
fi

if [ -n "$COMMENT_FILE" ]; then
	COMMENT="$(cat "$COMMENT_FILE")"
fi

gate=0
case "$PHASE" in
interview | blocked) gate=1 ;;
awaiting-merge)
	gate=1
	if [ -z "$PR" ]; then
		echo "harness-phase: awaiting-merge には --pr が必要です" >&2
		exit 2
	fi
	;;
esac
if [ "$gate" = 1 ] && [ -z "$COMMENT" ]; then
	echo "harness-phase: $PHASE は人間ゲートのため、読むべき本文（--comment / --comment-file）が必須です" >&2
	exit 2
fi

if [ "$PHASE" = awaiting-merge ] && [[ "$COMMENT" = *'【動きのない動画の場合だけ'* ]]; then
	echo 'harness-phase: 動かない動画の理由を記入するか条件行を削除してください' >&2; exit 2
fi
if [ "$PHASE" = awaiting-merge ] && { [[ "$COMMENT" = *'<!-- harness:'* ]] || [[ "$SUMMARY" = *'<!-- harness:'* ]]; }; then
	echo 'harness-phase: 本文と要約に harness marker は使えません' >&2
	exit 2
fi
[[ "$ISSUE" =~ ^[1-9][0-9]*$ ]] || exit 2
if [ "$PHASE" = awaiting-merge ]; then [[ "$PR" =~ ^[1-9][0-9]*$ ]] || exit 2; fi
umask 077
# 動画と投稿本文の一時ファイルは通知の完了まで保持する。
media_tmp="" comment_tmp="" convert_pid=""
cleanup() {
	if [ -n "$convert_pid" ]; then
		kill -TERM "$convert_pid" 2>/dev/null || true
		for ((attempt = 0; attempt < 20; attempt++)); do
			kill -0 "$convert_pid" 2>/dev/null || break
			sleep 0.05
		done
		kill -KILL "$convert_pid" 2>/dev/null || true
		wait "$convert_pid" 2>/dev/null || true
	fi
	[ -z "$comment_tmp" ] || rm -f -- "$comment_tmp"
	[ -z "$media_tmp" ] || rm -rf -- "$media_tmp"
	return 0
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
video_error() {
	echo "harness-phase: 動画準備失敗: $*（exit 6）。対応後に再実行してください。" >&2
	exit 6
}
video_file() { [ -f "$1" ] && [ -r "$1" ] && [ -s "$1" ]; }
probe_video() {
	if ! probe_json="$(ffprobe -v error -select_streams v:0 \
		-show_entries stream=codec_name,pix_fmt:format=format_name,duration:format_tags=major_brand \
		-of json "$FILE")"; then
		video_error "ffprobe の検査失敗。入力を確認するか再録画が必要です"
	fi
	if ! jq -e '
		(.streams | type == "array" and length > 0) and
		(.streams[0].codec_name | type == "string" and length > 0) and
		(.streams[0].pix_fmt | type == "string" and length > 0) and
		(.format.format_name | type == "string" and length > 0) and
		(.format.duration | tonumber | . > 0 and . < 1.7976931348623157e308)
	' <<<"$probe_json" >/dev/null 2>&1; then
		video_error "probe の JSON・映像・再生時間が不正です。再録画が必要です"
	fi
}
compatible_video() {
	[[ "${FILE,,}" = *.mp4 ]] && jq -e '
		(.format.format_name | split(",") | index("mp4") != null) and
		(.format.tags.major_brand as $brand | ["isom","iso2","mp41","mp42","avc1"] | index($brand) != null) and
		.streams[0].codec_name == "h264" and .streams[0].pix_fmt == "yuv420p"
	' <<<"$probe_json" >/dev/null 2>&1
}

# 要約は UTF-8 の文字単位で切る。位置の説明は切り出しの後に付ける。
if [ -z "$SUMMARY" ] && [ -n "$COMMENT" ]; then
	SUMMARY="$(printf '%s' "$COMMENT" | jq -Rrs '.[0:300]')"
fi
if [ "$PHASE" = awaiting-merge ] && [ -n "$FILE" ]; then
	video_file "$FILE" || video_error "入力が通常の読取可能な非空ファイルではありません。録画ファイルを指定してください"
	FILE="$(cd -- "$(dirname -- "$FILE")" && pwd)/$(basename -- "$FILE")"
	command -v ffprobe >/dev/null || video_error "ffprobe が必要です。FFmpeg のツールを導入してください"
	probe_video
	media_tmp="$(mktemp -d)" || video_error "一時領域を作成できません"
	if ! compatible_video; then
		command -v ffmpeg >/dev/null || video_error "変換に ffmpeg が必要です。FFmpeg を導入してください"
		output="$media_tmp/demo-$ISSUE-h264.mp4"
		ffmpeg -nostdin -v error -y -i "$FILE" \
			-map 0:v:0 -map '0:a:0?' -vf 'pad=ceil(iw/2)*2:ceil(ih/2)*2' \
			-c:v libx264 -pix_fmt yuv420p -c:a aac -movflags +faststart -f mp4 "$output" &
		convert_pid=$!
		if wait "$convert_pid"; then
			convert_pid=""
		else
			convert_pid=""
			video_error "ffmpeg の変換に失敗しました。codec の利用可否と入力を確認してください"
		fi
		FILE="$output"
		video_file "$FILE" || video_error "変換成果物が空または読取不能です。入力と空き容量を確認してください"
		probe_video
		compatible_video || video_error "変換後の形式が不適合です。ffmpeg の機能を確認してください"
	else
		cp -- "$FILE" "$media_tmp/demo-$ISSUE-h264.mp4" || video_error "コピー失敗"
		FILE="$media_tmp/demo-$ISSUE-h264.mp4"
		probe_video
		compatible_video || video_error "固定ファイルが不適合です"
	fi
	video_file "$FILE" || video_error "最終動画が欠落・空・読取不能です。録画を確認してください"
	max_mb="$("$SCRIPT_DIR/harness-config" '.notify.maxAttachMB' 10)" || video_error "添付上限設定を確認してください"
	[[ "$max_mb" =~ ^[1-9][0-9]*$ ]] || video_error "notify.maxAttachMB は正整数にしてください"
	size="$(wc -c < "$FILE")" || video_error "最終動画を読み取れません。録画を確認してください"
	jq -en --arg size "$size" --arg max "$max_mb" '($size | tonumber) <= (($max | tonumber) * 1048576)' >/dev/null \
		|| video_error "最終動画が添付上限を超えています。短い録画を用意してください"
	node "$SCRIPT_DIR/../src/notification-receipt.ts" fingerprint "$FILE" >"$media_tmp/fingerprint.json" || video_error "fingerprint 失敗"
	location="動画: この通知の Discord メッセージに添付（ファイル名 demo-$ISSUE-h264.mp4）。長文で分かれる場合は最後の投稿にあります。"
	SUMMARY="$(jq -nr --arg text "$SUMMARY" --arg location "$location" '$text[0:(3500 - ($location | length) - 2)] + "\n\n" + $location')"
fi
if [ "$PHASE" = awaiting-merge ]; then
	[ -n "$media_tmp" ] || media_tmp="$(mktemp -d)"
	printf '%s' "$COMMENT" >"$media_tmp/comment.md"
	printf '%s' "$SUMMARY" >"$media_tmp/summary.md"
	node "$SCRIPT_DIR/../src/harness-request.ts" "$ISSUE" "$PR" "$media_tmp/comment.md" "$media_tmp/summary.md" "$FILE" "$media_tmp" &
	convert_pid=$!
	rc=0
	wait "$convert_pid" || rc=$?
	convert_pid=""
	[ "$rc" = 0 ] || exit "$rc"
	# 表示用台帳報告は通常経路末尾と同様に best effort。
	DLE_SOCK="${DLE_SOCKET:-${DLE_HOME:-$HOME/.discord-loop-engine}/engine.sock}"
	if [ -S "$DLE_SOCK" ] && [ -x "$SCRIPT_DIR/dle" ]; then
		"$SCRIPT_DIR/dle" notify --event phase --phase awaiting-merge --issue "$ISSUE" --pr "$PR" --project "${DLE_PROJECT:-$("$SCRIPT_DIR/harness-config" .project "$(basename "$("$SCRIPT_DIR/harness-config" --root)")")}" >/dev/null 2>&1 || true
	fi
	exit 0
fi

TITLE="$(gh issue view "$ISSUE" --json title -q .title)"
ISSUE_URL="$(gh issue view "$ISSUE" --json url -q .url)"

# --- 1) 本文を GitHub に投稿 ---------------------------------------------------
LINK="$ISSUE_URL"
if [ -n "$COMMENT" ]; then
	sha=""
	if [ -n "$PR" ]; then
		sha="$(gh pr view "$PR" --json headRefOid -q .headRefOid)"
	fi
	marker="<!-- harness:gate phase=$PHASE issue=$ISSUE${sha:+ sha=$sha} -->"
	body="$COMMENT

---
_discord-loop-engine · \`$PHASE\`${sha:+ · head \`${sha:0:7}\`}_
$marker"
	comment_tmp="$(mktemp)"
	printf '%s\n' "$body" >"$comment_tmp"
	if [ "$PHASE" = "awaiting-merge" ]; then
		LINK="$(gh pr comment "$PR" --body-file "$comment_tmp" | tail -n 1)"
	else
		LINK="$(gh issue comment "$ISSUE" --body-file "$comment_tmp" | tail -n 1)"
	fi
	rm -f "$comment_tmp"
	comment_tmp=""
	echo "harness-phase: コメントを投稿しました: $LINK" >&2
fi

# --- 2) Discord 通知（人間ゲートは必須。失敗したらラベルを変えずに終了） ---------
event=""
case "$PHASE" in
interview) event="interview" ;;
awaiting-merge) event="merge-request" ;;
blocked) event="blocked" ;;
designing) [ "$NOTIFY" = 1 ] && event="started" ;;
*) [ "$NOTIFY" = 1 ] && event="info" ;;
esac

if [ -n "$event" ]; then
	notify_args=(--event "$event" --title "$TITLE" --url "$LINK" --issue "$ISSUE")
	[ -n "$PR" ] && notify_args+=(--pr "$PR")
	[ -n "$SUMMARY" ] && notify_args+=(--body "$SUMMARY")
	[ -n "$FILE" ] && notify_args+=(--file "$FILE")
	if ! "$SCRIPT_DIR/harness-notify" "${notify_args[@]}"; then
		echo "harness-phase: Discord 通知に失敗したため、ラベルは変更していません（$PHASE へは未遷移）。" >&2
		echo "  原因を解消して同じコマンドを再実行してください。" >&2
		exit 4
	fi
fi

# --- 3) ラベル付け替え --------------------------------------------------------
current="$(gh issue view "$ISSUE" --json labels -q '.labels[].name' | grep '^harness:' || true)"
edit_args=()
while IFS= read -r l; do
	[ -z "$l" ] && continue
	[ "$l" = "harness:$PHASE" ] && continue
	# merge-ok はマージ承認の記録なので done 以外では残す
	[ "$l" = "harness:merge-ok" ] && [ "$PHASE" != "done" ] && continue
	edit_args+=(--remove-label "$l")
done <<<"$current"
if [ "$PHASE" != "done" ]; then
	edit_args+=(--add-label "harness:$PHASE")
fi
if [ ${#edit_args[@]} -gt 0 ]; then
	if ! gh issue edit "$ISSUE" "${edit_args[@]}" >/dev/null; then
		echo "harness-phase: ラベル変更に失敗しました。ラベル未作成なら harness-labels を実行してください。" >&2
		exit 5
	fi
fi
# engine が動いていれば台帳にもフェーズを残す（ボードと「今なにをしているか」のため。失敗してもフェーズ遷移は止めない）
DLE_SOCK="${DLE_SOCKET:-${DLE_HOME:-$HOME/.discord-loop-engine}/engine.sock}"
if [ -S "$DLE_SOCK" ] && [ -x "$SCRIPT_DIR/dle" ]; then
	"$SCRIPT_DIR/dle" notify --event phase --phase "$PHASE" --issue "$ISSUE" --title "$TITLE" --url "$ISSUE_URL" \
		${PR:+--pr "$PR"} --project "${DLE_PROJECT:-$("$SCRIPT_DIR/harness-config" .project "$(basename "$("$SCRIPT_DIR/harness-config" --root)")")}" \
		>/dev/null 2>&1 || true
fi
echo "harness-phase: #$ISSUE → $PHASE" >&2
