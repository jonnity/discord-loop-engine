#!/usr/bin/env bash
#
# harness-gate — PR 作成前ゲート。harness.json の gate に並べた検査を全部実行し、最後に一覧を出す。
#
# 最初の失敗で止めないのは、「直す→別の所で落ちる」の往復を1回で済ませるため
# （oogiri-doc の pnpm ci:local と同じ考え方）。CI と同じ検査を同じ順で並べておけば、
# ここを通した PR が CI で赤くなったときに「コード起因ではない」と疑う根拠になる。
#
# 使い方: harness-gate [<実行ディレクトリ>]   # 既定はカレント（worktree で実行する）
#
# harness.json:
#   "gate": [ {"name": "types", "run": "npm run typecheck"}, ... ]
#   "hooks": { "beforePR": ["pnpm ci:local"] }   # gate の後に、リポジトリ独自の PR 前検査として実行する

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIR="${1:-$(pwd)}"
cd "$DIR" || exit 2

CONFIG="$("$SCRIPT_DIR/harness-config" --path)"
if [ ! -f "$CONFIG" ] || ! jq -e 'type == "object" and (.gate | type == "array")' "$CONFIG" >/dev/null 2>&1; then
	echo "harness-gate: harness.json に gate が定義されていません" >&2
	exit 2
fi
# 設定不備は環境コマンドを実行する前に止める。
if ! jq -e '
	((.preflight == null) or (.preflight | type == "array" and all(.[];
		type == "object" and
		(.name | type == "string" and test("\\S")) and
		(.run | type == "string" and test("\\S")))))
' "$CONFIG" >/dev/null 2>&1; then
	echo "harness-gate: preflight の設定が不正です（name/run は空でない文字列の配列、exit 2）" >&2
	exit 2
fi
count="$(jq '.gate | length' "$CONFIG" 2>/dev/null)" || count=""
if [ -z "$count" ] || [ "$count" = 0 ]; then
	echo "harness-gate: harness.json に gate が定義されていません" >&2
	exit 2
fi

# 子が環境や設定を変えても、定義と hook の有無は親が先に確定する。
preflight_count="$(jq '(.preflight // []) | length' "$CONFIG")"
hook_count="$(jq '(.hooks.beforePR // []) | length' "$CONFIG" 2>/dev/null || echo 0)"
pre_names=()
pre_runs=()
gate_names=()
gate_runs=()
for ((i = 0; i < preflight_count; i++)); do
	pre_names+=("$(jq -r ".preflight[$i].name" "$CONFIG")")
	pre_runs+=("$(jq -r ".preflight[$i].run" "$CONFIG")")
done
for ((i = 0; i < count; i++)); do
	gate_names+=("$(jq -r ".gate[$i].name" "$CONFIG")")
	gate_runs+=("$(jq -r ".gate[$i].run" "$CONFIG")")
done

gate_tmp=""
cleanup() { [ -z "$gate_tmp" ] || rm -rf -- "$gate_tmp"; }
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
if ! gate_tmp="$(mktemp -d)" || [ -z "$gate_tmp" ] || [ ! -d "$gate_tmp" ]; then
	echo "harness-gate: 隔離用の一時領域を準備できません（exit 3）" >&2
	exit 3
fi
isolation_failed=0
run_isolated() {
	local command_home rc=0
	if ! command_home="$(mktemp -d "$gate_tmp/command.XXXXXX")" || [ -z "$command_home" ] || [ ! -d "$command_home" ]; then
		echo "harness-gate: 隔離用の一時領域を準備できません（exit 3）" >&2
		isolation_failed=1
		return 1
	fi
	(
		while IFS= read -r key; do
			case "$key" in DLE_*|DISCORD_*) unset -v "$key" ;; esac
		done < <(compgen -e)
		export DLE_HOME="$command_home" DLE_SOCKET="$command_home/engine.sock"
		bash -c "$1"
	) || rc=$?
	rm -rf -- "$command_home"
	return "$rc"
}

results=()
for ((i = 0; i < preflight_count; i++)); do
	name="${pre_names[$i]}"
	run="${pre_runs[$i]}"
	echo "=== [preflight: $name] $run" >&2
	if run_isolated "$run"; then
		results+=("✅ preflight: $name")
	else
		[ "$isolation_failed" = 0 ] || exit 3
		results+=("❌ preflight: $name")
		printf '%s\n' "${results[@]}" >&2
		echo "harness-gate: 環境確認に失敗しました。環境を整えて再実行してください（exit 3）" >&2
		exit 3
	fi
done
failed=0
for i in $(seq 0 $((count - 1))); do
	name="${gate_names[$i]}"
	run="${gate_runs[$i]}"
	echo "=== [$name] $run" >&2
	start=$(date +%s)
	if run_isolated "$run"; then
		results+=("✅ $name ($(($(date +%s) - start))s)")
	else
		[ "$isolation_failed" = 0 ] || exit 3
		results+=("❌ $name ($(($(date +%s) - start))s)  ← $run")
		failed=1
	fi
done

if [ "$hook_count" != 0 ]; then
	start=$(date +%s)
	if "$SCRIPT_DIR/harness-hook" beforePR --dir "$DIR"; then
		results+=("✅ hooks.beforePR ($(($(date +%s) - start))s)")
	else
		results+=("❌ hooks.beforePR ($(($(date +%s) - start))s)")
		failed=1
	fi
fi

echo "" >&2
echo "=== harness-gate 結果 ($DIR)" >&2
printf '%s\n' "${results[@]}" >&2
exit "$failed"
