#!/usr/bin/env bash
#
# harness-merge — 人間の承認を確認してから PR をマージし、Issue を done にして完了通知する。
#
# 承認として認めるもの（どれか1つ）:
#   - harness-inbox が merge-ok を返す（owner の "OK" コメント / Approve / harness:merge-ok ラベル）
#   - --chat-approval "<ユーザーの発言の引用>"（対話チャットで OK をもらった場合。PR に記録を残す）
# マージ前に、承認依頼を出した head sha と現在の head が一致していること、CI が green であること、
# mergeable であること、profile の hooks.beforeMerge（例: SonarCloud の New issues が 0）が通ることを確認する。
# どれかが崩れていたらマージしない。
#
# 使い方: harness-merge <issue> [--chat-approval "<引用>" --attention <回答元A-id>]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cfg() { "$SCRIPT_DIR/harness-config" "$@" 2>/dev/null || true; }

ISSUE="${1:-}"
[ $# -ge 1 ] || exit 2
shift
CHAT="" ATTENTION="" seen_chat=0 seen_attention=0
while [ $# -gt 0 ]; do
	case "$1" in
	--chat-approval) [ "$seen_chat" = 0 ] && [ $# -ge 2 ] && [ -n "$2" ] && [[ "$2" != --* ]] || exit 2; CHAT="$2"; seen_chat=1; shift 2 ;;
	--attention) [ "$seen_attention" = 0 ] && [ $# -ge 2 ] || exit 2; ATTENTION="$2"; seen_attention=1; shift 2 ;;
	*) exit 2 ;;
	esac
done
if [ "$seen_chat" != "$seen_attention" ]; then exit 2; fi
if [ "$seen_attention" = 1 ] && [[ ! "$ATTENTION" =~ ^A-[1-9][0-9]*$ ]]; then exit 2; fi
[[ "$ISSUE" =~ ^[1-9][0-9]*$ ]] || exit 2
prefix="$(cfg '.branchPrefix' 'fix/issue-')"
method="$(cfg '.mergeMethod' 'merge')"
case "$method" in merge|squash|rebase) ;; *) exit 1 ;; esac
PR="$(gh pr list --state open --head "${prefix}${ISSUE}" --json number -q '.[0].number // empty')"
[ -n "$PR" ] || exit 1
validate() {
	local worktree recovery
	worktree="$(cfg --worktree "$ISSUE")"
	for recovery in ".harness/merge-recovery-$ISSUE.json" ${worktree:+"$worktree/.harness/merge-recovery-$ISSUE.json"}; do
		if [ -e "$recovery" ] || [ -L "$recovery" ]; then
			echo "harness-merge: 復旧未確認のためマージしません" >&2
			return 1
		fi
	done
	snapshot="$(node "$SCRIPT_DIR/../src/harness-approval.ts" "$ISSUE" "$PR")" || return 1
	if ! jq -e --arg attention "$ATTENTION" --arg chat "$CHAT" '
		.status == "ready" and .gate != null and .verdict.kind != "merge-ng"
		and (if $chat != "" then .gate.attention == $attention else .verdict.kind == "merge-ok" end)' <<<"$snapshot" >/dev/null; then
		current_url="$(jq -r .url <<<"$snapshot")"
		echo "harness-merge: この回答は現在の完成した承認依頼に対応しないか、承認なし・NG・未完了です。マージしません。現在の依頼: $current_url。未完了なら復旧後の完成を待ち、内容を確認して回答してください。" >&2
		return 1
	fi
}
validate || exit 1
initial="$(jq -c .gate <<<"$snapshot")"

state="$(gh pr view "$PR" --json mergeable,mergeStateStatus,statusCheckRollup)"
mergeable="$(printf '%s' "$state" | jq -r .mergeable)"
bad_checks="$(printf '%s' "$state" | jq -r '[.statusCheckRollup[]? | select((.conclusion // .state) as $c | ($c != "SUCCESS" and $c != "NEUTRAL" and $c != "SKIPPED"))] | map(.name // .context) | join(", ")')"
if [ "$mergeable" != "MERGEABLE" ]; then
	echo "harness-merge: PR #$PR が mergeable ではありません（$mergeable）。base を取り込んでから再実行してください" >&2
	exit 1
fi
if [ -n "$bad_checks" ]; then
	echo "harness-merge: green でないチェックがあります: $bad_checks" >&2
	exit 1
fi

if ! "$SCRIPT_DIR/harness-hook" beforeMerge --issue "$ISSUE" --pr "$PR"; then
	echo "harness-merge: hooks.beforeMerge が通らないためマージしません" >&2
	exit 1
fi

validate || exit 1
[ "$(jq -c .gate <<<"$snapshot")" = "$initial" ] || { echo "harness-merge: 依頼/head/完成時刻が変化したため停止します" >&2; exit 1; }
head="$(jq -r .gate.head <<<"$snapshot")"
if [ -n "$CHAT" ]; then
	gh pr comment "$PR" --body "チャットでマージ承認を受けました:
> $CHAT

<!-- harness:approval source=chat attention=$ATTENTION sha=$head -->" >/dev/null
fi

gh pr merge "$PR" "--$method" --match-head-commit "$head"
"$SCRIPT_DIR/harness-phase" "$ISSUE" "done" --pr "$PR"
