#!/usr/bin/env bash
#
# harness-merge — 人間の承認を確認してから PR をマージし、Issue を done にして完了通知する。
#
# 承認として認めるもの（どれか1つ）:
#   - harness-inbox が merge-ok を返す（owner の "OK" コメント / Approve / harness:merge-ok ラベル）
#   - --chat-approval と --attention（台帳の回答済み OK を再検証し、その原文を PR に記録する）
# マージ前に、承認依頼を出した head sha と現在の head が一致していること、CI が green であること、
# mergeable であること、profile の hooks.beforeMerge（例: SonarCloud の New issues が 0）が通ることを確認する。
# どれかが崩れていたらマージしない。
#
# 使い方: harness-merge <issue> [--pr <PR番号>] [--chat-approval "<引用>" --attention <回答元A-id>]
#   --pr: head が branchPrefix+<issue> でない既存 PR（feat/ ブランチ等）を対象にする。
#         PR は自リポジトリの open PR（fork の head は不可）で、その PR に付いた承認依頼コメント・人の OK で
#         証明する（番号は呼び出し側の申告を信用しない）。Issue 全体に効く harness:merge-ok ラベルは
#         別の PR への承認・新しい GitHub の NG と区別できないため、--pr ではラベルが付いている限り GitHub 経路
#         でもチャット経路でも拒否する（ラベルを外し、OK コメント / Approve / PR に一致するチャット回答を使う）。
#         PR 上の OK / Approve だけの場合は tick に出ないため、窓口の明示の指示で worker が harness-merge <issue> --pr <番号> を実行する。
#         それ以外の安全柵は --pr なしと同じコードを通る。
#   第1引数が --pr の形（harness-merge --pr <番号>）は Dependabot 用で、別経路（harness-pr.ts）。

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "${1:-}" = --pr ]; then
	exec node "$SCRIPT_DIR/../src/harness-pr.ts" merge "$@"
fi
cfg() { "$SCRIPT_DIR/harness-config" "$@" 2>/dev/null || true; }

CHAT="" ATTENTION="" PR_ARG="" seen_chat=0 seen_attention=0
PR="" current_url=""
# 拒否した入力の A だけを返し、現在の A や台帳全文を診断へ載せない。
reject() {
	local reason="$1" fallback_url="$current_url"
	if [ -z "$fallback_url" ] && [ -n "$PR" ]; then
		fallback_url="$(gh pr view "$PR" --json headRefOid,url | jq -r .url)" || fallback_url=""
	fi
	if [ "$seen_chat" = 1 ] || [ "$seen_attention" = 1 ]; then
		jq -nc --arg attention "$ATTENTION" --arg reason "$reason" --arg url "$fallback_url" \
			'{kind:"chat-rejection",attention:(if ($attention | test("^A-[1-9][0-9]*$")) then $attention else null end),reason:$reason,url:$url}' >&2
	fi
	echo "harness-merge: $reason。マージしません。現在の依頼: $current_url。現在の完成依頼を確認し、PR に GitHub で『OK』とコメントするか、窓口に『#$ISSUE の承認依頼を出し直して』と頼んでください。" >&2
	return 1
}
invalid() { reject invalid-arguments || true; exit 2; }
ISSUE="${1:-}"
[ $# -ge 1 ] || exit 2
shift
while [ $# -gt 0 ]; do
	case "$1" in
	--chat-approval) seen_chat=1; [ -z "$CHAT" ] && [ $# -ge 2 ] && [ -n "$2" ] && [[ "$2" != --* ]] || invalid; CHAT="$2"; seen_chat=1; shift 2 ;;
	--attention) [ "$seen_attention" = 0 ] && [ $# -ge 2 ] || invalid; ATTENTION="$2"; seen_attention=1; shift 2 ;;
	--pr) [ -z "$PR_ARG" ] && [ $# -ge 2 ] && [[ "$2" =~ ^[1-9][0-9]*$ ]] || invalid; PR_ARG="$2"; shift 2 ;;
	*) invalid ;;
	esac
done
if [ "$seen_chat" != "$seen_attention" ]; then invalid; fi
if [ "$seen_attention" = 1 ] && [[ ! "$ATTENTION" =~ ^A-[1-9][0-9]*$ ]]; then invalid; fi
[[ "$ISSUE" =~ ^[1-9][0-9]*$ ]] || invalid
prefix="$(cfg '.branchPrefix' 'fix/issue-')"
method="$(cfg '.mergeMethod' 'merge')"
case "$method" in merge|squash|rebase) ;; *) exit 1 ;; esac
if [ -n "$PR_ARG" ]; then
	# fork の head は branchPrefix 経路には無かった追加の拒否条件（安全側）。closed / merged も対象外。
	pr_meta="$(gh pr view "$PR_ARG" --json state,isCrossRepository)" || { reject pr-unavailable || true; exit 1; }
	[ "$(jq -r '[.state, (.isCrossRepository | tostring)] | join(" ")' <<<"$pr_meta" 2>/dev/null)" = "OPEN false" ] || { reject pr-unavailable || true; exit 1; }
	PR="$PR_ARG"
else
	PR="$(gh pr list --state open --head "${prefix}${ISSUE}" --json number -q '.[0].number // empty')" || { reject pr-unavailable || true; exit 1; }
fi
[ -n "$PR" ] || { reject pr-unavailable || true; exit 1; }
validate() {
	local worktree recovery reason
	snapshot="$(node "$SCRIPT_DIR/../src/harness-approval.ts" "$ISSUE" "$PR" --with-attention)" || { reject approval-unavailable; return 1; }
	current_url="$(jq -er '.url | select(type == "string" and length > 0)' <<<"$snapshot")" || { reject approval-unavailable; return 1; }
	worktree="$(cfg --worktree "$ISSUE")"
	for recovery in ".harness/merge-recovery-$ISSUE.json" ${worktree:+"$worktree/.harness/merge-recovery-$ISSUE.json"}; do
		if [ -e "$recovery" ] || [ -L "$recovery" ]; then
			echo "harness-merge: 復旧未確認のためマージしません" >&2
			reject recovery-unconfirmed
			return 1
		fi
	done
	reason="$(jq -r --arg attention "$ATTENTION" --arg chat "$CHAT" --arg pr_arg "$PR_ARG" '
		if .ownersUnavailable then "attention-unavailable"
		elif .verdict.kind == "merge-ng" then "github-ng"
		elif .requestState == "pending" then "request-failed"
		elif .requestInactive then "request-inactive"
		elif .status == "stale-notify" then "request-stale"
		elif .status != "ready" or .gate == null then "request-missing"
		elif .githubApprovalBlocked then .attentionCheck.reason
		# --pr のラベル承認は Issue 単位で別 PR への承認・新しい GitHub の NG と区別できないため、GitHub 経路でも
		# チャット経路でも認めない（fail closed）。ラベル由来の判定だけが本文が空で URL が PR 本体（コメント・
		# レビューは # 付き）。同じ1回の snapshot で判定し、別読取りを挟まない。
		elif $pr_arg != "" and .verdict.kind == "merge-ok" and .verdict.body == "" and ((.verdict.url // "") | test("#") | not) then "request-inactive"
		elif $chat == "" then (if .verdict.kind != "merge-ok" then "request-inactive" else "" end)
		elif .gate.attention == null then "attention-none"
		elif .gate.attention != $attention then "attention-stale"
		elif .attentionCheck.state == "approved" then ""
		elif .attentionCheck.state == "missing" then "attention-not-found"
		elif .attentionCheck.state == "open" then "attention-open"
		else (.attentionCheck.reason // "attention-unavailable") end' <<<"$snapshot")" || { reject approval-unavailable; return 1; }
	if [ -n "$reason" ]; then reject "$reason"; return 1; fi
}
identity() {
	jq -c --arg chat "$CHAT" '{gate,answer:(if $chat != "" then .attentionCheck else null end)}' <<<"$snapshot"
}
validate || exit 1
initial="$(identity)"

state="$(gh pr view "$PR" --json mergeable,mergeStateStatus,statusCheckRollup)" || { reject approval-unavailable || true; exit 1; }
mergeable="$(printf '%s' "$state" | jq -r .mergeable)"
bad_checks="$(printf '%s' "$state" | jq -r '[.statusCheckRollup[]? | select((.conclusion // .state) as $c | ($c != "SUCCESS" and $c != "NEUTRAL" and $c != "SKIPPED"))] | map(.name // .context) | join(", ")')"
if [ "$mergeable" != "MERGEABLE" ]; then
	reject mergeable-unconfirmed || true
	echo "harness-merge: PR #$PR の未処理承認と待ち理由を記録し、base を取り込んで必要な修正後は再依頼してください（$mergeable）" >&2
	exit 1
fi
if [ -n "$bad_checks" ]; then
	reject ci-not-green || true
	echo "harness-merge: green でないチェックがあります: $bad_checks" >&2
	exit 1
fi

# プロジェクトが merge.requiredChecks を指定したときだけ、必須の検査が現在の head で SUCCESS であることを要求する（opt-in）。
# cfg() は失敗を握りつぶして空にするため、不正な merge を「指定なし」と取り違えないよう harness-config を直接呼ぶ。
# 終了 1 は「キー無し・設定無し」（指定なし）、1 以外の非 0 は jq の型エラー（merge が配列・文字列など）で fail closed。
required_rc=0
required="$("$SCRIPT_DIR/harness-config" '.merge.requiredChecks | select(. != null) | tojson' 2>/dev/null)" || required_rc=$?
required_invalid() {
	reject required-checks-invalid || true
	echo "harness-merge: harness.json の merge.requiredChecks は文字列の配列、merge.hint は文字列で指定してください" >&2
	exit 1
}
if [ "$required_rc" -gt 1 ]; then required_invalid; fi
if [ "$required_rc" = 0 ] && [ -n "$required" ]; then
	jq -e 'type == "array" and all(.[]; type == "string" and length > 0)' <<<"$required" >/dev/null 2>&1 || required_invalid
	if [ "$(jq 'length' <<<"$required")" -gt 0 ]; then
		hint_rc=0
		hint="$("$SCRIPT_DIR/harness-config" '.merge.hint | select(. != null) | if type == "string" then . else error("hint") end' 2>/dev/null)" || hint_rc=$?
		if [ "$hint_rc" -gt 1 ]; then required_invalid; fi
		[ "$hint_rc" = 0 ] || hint=""
		req_state="$(gh pr view "$PR" --json headRefOid,statusCheckRollup)" || { reject approval-unavailable || true; exit 1; }
		cur_head="$(jq -r '.headRefOid | strings' <<<"$req_state" 2>/dev/null)" || cur_head=""
		want_head="$(jq -r .gate.head <<<"$snapshot")"
		hex40='^[0-9a-f]{40}$'
		if [[ ! "$cur_head" =~ $hex40 ]] || [[ ! "$want_head" =~ $hex40 ]] || [ "$cur_head" != "$want_head" ]; then
			reject request-stale || true
			echo "harness-merge: 承認依頼の head ${want_head:0:7} と現在の head ${cur_head:0:7} が違います。承認依頼を出し直し、現在の head で検査を実行してください" >&2
			exit 1
		fi
		# 合格は積極判定のみ（一致する要素が 1 件以上で全件 SUCCESS）。jq の失敗・空出力は合格にしない。
		# 名前は --argjson で渡し、== で完全一致させる（正規表現や部分一致にしない）。
		unmet_rc=0
		unmet="$(jq -c --argjson req "$required" '
			if (.statusCheckRollup | type) != "array" then error("rollup") else . end
			| .statusCheckRollup as $r
			| [$req[] as $n
				| [$r[] | select((.name // .context) == $n)
					| (if (.status // "") != "" then (if .status == "COMPLETED" then (.conclusion // "") else .status end) else (.state // "") end)
					| if . == "" then "不明" else . end] as $states
				| if ($states | length) == 0 then "  - \($n): 未実行（statusCheckRollup に見つかりません）"
				  elif all($states[]; . == "SUCCESS") then empty
				  else "  - \($n): \([$states[] | select(. != "SUCCESS") | if IN("IN_PROGRESS", "QUEUED", "WAITING", "PENDING", "REQUESTED") then "pending(\(.))" else . end] | unique | join(", "))" end] as $lines
			| {ok: ($lines | length == 0), lines: $lines}' <<<"$req_state" 2>/dev/null)" || unmet_rc=$?
		if [ "$unmet_rc" != 0 ] || ! jq -e '.ok == true' <<<"$unmet" >/dev/null 2>&1; then
			reject required-checks-unmet || true
			echo "harness-merge: 承認依頼の出し直しではなく、必須の検査を通してください。" >&2
			echo "harness-merge: 必須の検査が現在の head ${cur_head:0:7} で success になっていません:" >&2
			if [ "$unmet_rc" = 0 ]; then jq -r '.lines[]' <<<"$unmet" >&2; else echo "  - statusCheckRollup を判定できませんでした" >&2; fi
			if [ -n "$hint" ]; then
				echo "$hint" >&2
			else
				echo "足すもの: 各検査を現在の head で実行して success にしてください（検査名は statusCheckRollup の name と完全一致で照合しています）。" >&2
				echo "head を更新した場合は、古い head の結果は数えないので再実行が要ります。" >&2
			fi
			exit 1
		fi
	fi
fi

if ! "$SCRIPT_DIR/harness-hook" beforeMerge --issue "$ISSUE" --pr "$PR"; then
	reject before-merge-failed || true
	echo "harness-merge: hooks.beforeMerge が通らないためマージしません" >&2
	exit 1
fi

validate || exit 1
[ "$(identity)" = "$initial" ] || { reject approval-changed || true; exit 1; }
head="$(jq -r .gate.head <<<"$snapshot")"
if [ -n "$CHAT" ]; then
	IFS= read -r -d '' CHAT < <(jq -j '.attentionCheck.body, "\u0000"' <<<"$snapshot") || true
	gh pr comment "$PR" --body "チャットでマージ承認を受けました:
> $CHAT

<!-- harness:approval source=chat attention=$ATTENTION sha=$head -->" >/dev/null
fi

gh pr merge "$PR" "--$method" --match-head-commit "$head"
"$SCRIPT_DIR/harness-phase" "$ISSUE" "done" --pr "$PR"
